@model List<CategoryDto>
@{
    ViewData["Title"] = "Categories";
}

<h2 class="mb-3">Categories</h2>

<a asp-action="CategoryCreate" class="btn btn-success mb-3">+ Create New Category</a>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Parent Category</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>
                    @if (item.ParentCategoryId != null)
                    {
                        <span class="text-muted">@item.ParentCategoryName</span>
                    }
                    else
                    {
                        <strong>Main Category</strong>
                    }
                </td>
                <td>
                    <a asp-action="CategoryEdit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">
                        <i class="fas fa-edit"></i>
                    </a>
                    <a asp-action="CategoryDelete" class="btn btn-sm btn-danger" asp-route-Id="@item.Id">
                        <i class="fas fa-trash"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
