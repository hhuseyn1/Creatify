@model ShopDto

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<form asp-action="ShopCreate" enctype="multipart/form-data">
    <br />
    <div class="container border p-3">
        <h1 class="text-primary">Create Shop</h1>
        <hr />
        <div class="row">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="col-2">
                <label asp-for="Name" class="control-label pt-2" style="font-size:20px;"></label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-2">
                <label asp-for="OwnerEmail" class="control-label pt-2" style="font-size:20px;">Owner Email</label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="OwnerEmail" class="form-control" />
                <span asp-validation-for="OwnerEmail" class="text-danger"></span>
            </div>

            <div class="col-2">
                <label asp-for="ContactEmail" class="control-label pt-2" style="font-size:20px;">Contact Email</label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="ContactEmail" class="form-control" />
                <span asp-validation-for="ContactEmail" class="text-danger"></span>
            </div>

            <div class="col-2">
                <label asp-for="PhoneNumber" class="control-label pt-2" style="font-size:20px;">Phone Number</label>
            </div>
            <div class="col-10 pb-3">
                <div class="d-flex align-items-center">
                    <select id="countryCode" asp-for="CountryCode" name="CountryCode" class="form-select me-2" style="max-width: 300px;">
                        <option value="">Loading...</option>
                    </select>
                    <input asp-for="PhoneNumber" class="form-control" style="max-width: 300px;"/>
                </div>
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="col-2">
                <label class="control-label pt-2" style="font-size:20px;">Shop Location</label>
            </div>
            <div class="col-10 pb-3">
                <div id="map" style="height: 400px;"></div>
                <input asp-for="Location" id="Location" class="form-control mt-2" readonly />
                <span asp-validation-for="Location" class="text-danger"></span>
            </div>

            <div class="col-2">
                <label asp-for="Description" class="control-label pt-2" style="font-size:20px;"></label>
            </div>
            <div class="col-10 pb-3">
                <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="col-2">
                <label asp-for="ImageLocalPath" class="control-label pt-2" style="font-size:20px;">Banner Image</label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="ImageLocalPath" accept=".jpg, .png" type="file" class="form-control" />
                <span asp-validation-for="ImageLocalPath" class="text-danger"></span>
            </div>

            <div class="col-5 offset-2">
                <a asp-action="ShopIndex" class="btn-primary btn form-control">Back to List</a>
            </div>
            <div class="col-5">
                <input type="submit" value="Create" class="btn btn-success form-control" />
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        var map = L.map('map').setView([40.4093, 49.8671], 12);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap contributors'
        }).addTo(map);
        var marker;
        map.on('click', function (e) {
            if (marker) {
                map.removeLayer(marker);
            }
            marker = L.marker(e.latlng).addTo(map);
            document.getElementById('Location').value = e.latlng.lat + ',' + e.latlng.lng;
        });

        document.addEventListener("DOMContentLoaded", function () {
            fetch("https://restcountries.com/v3.1/all")
                .then(response => response.json())
                .then(data => {
                    const select = document.getElementById("countryCode");
                    select.innerHTML = "";
                    data.sort((a, b) => a.name.common.localeCompare(b.name.common));
                    var count = 0;
                    data.forEach(country => {
                        if (country.idd && country.idd.root) {
                            const code = country.idd.root + ((country.idd.suffixes && country.idd.suffixes.length) ? country.idd.suffixes[0] : "");
                            if (code && code.length > 1) {
                                const option = document.createElement("option");
                                option.value = code;
                                option.text = `${country.name.common} (${code})`;
                                select.appendChild(option);
                                count++;
                            }
                        }
                    });
                    if (count === 0) {
                        select.innerHTML = '<option value="">Not found</option>';
                    }
                })
                .catch(error => {
                    document.getElementById("countryCode").innerHTML =
                        '<option value="">Can not load</option>';
                });
        });
    </script>
}
