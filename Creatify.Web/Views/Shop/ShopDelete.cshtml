@model ShopDto

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<form asp-action="ShopDelete">
    <input asp-for="Id" type="hidden" />
    <br />
    <div class="container border p-3">
        <h1 class="text-primary">Delete Shop</h1>

        <hr />
        <div class="row">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="col-2">
                <label asp-for="Name" class="control-label pt-2" style="font-size:20px;"></label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="Name" disabled class="form-control" />
            </div>

            <div class="col-2">
                <label asp-for="OwnerEmail" class="control-label pt-2" style="font-size:20px;">Owner Email</label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="OwnerEmail" disabled class="form-control" />
            </div>

            <div class="col-2">
                <label asp-for="ContactEmail" class="control-label pt-2" style="font-size:20px;">Contact Email</label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="ContactEmail" disabled class="form-control" />
            </div>

            <div class="col-2">
                <label asp-for="PhoneNumber" class="control-label pt-2" style="font-size:20px;">Phone Number</label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="PhoneNumber" disabled class="form-control" />
            </div>

            <div class="col-2">
                <label class="control-label pt-2" style="font-size:20px;">Shop Location</label>
            </div>
            <div class="col-10 pb-3">
                <div id="map" style="height: 400px;"></div>
                <input asp-for="Location" disabled class="form-control mt-2" />
            </div>

            <div class="col-2">
                <label asp-for="Description" class="control-label pt-2" style="font-size:20px;"></label>
            </div>
            <div class="col-10 pb-3">
                <textarea asp-for="Description" disabled class="form-control" rows="5"></textarea>
            </div>

            <div class="col-2">
                <label class="control-label pt-2" style="font-size:20px;">Banner</label>
            </div>
            <div class="col-10 pb-3">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" width="300" class="mb-2" />
                }
            </div>

            <div class="col-5 offset-2">
                <a asp-action="ShopIndex" class="btn-primary btn form-control">Back to List</a>
            </div>
            <div class="col-5">
                <input type="submit" value="Delete" class="btn btn-danger form-control" />
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        var map = L.map('map').setView([40.4093, 49.8671], 12);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap contributors'
        }).addTo(map);

        var locationValue = '@Model.Location';
        if (locationValue && locationValue.includes(",")) {
            var loc = locationValue.split(',');
            if (loc.length === 2) {
                var lat = parseFloat(loc[0]);
                var lng = parseFloat(loc[1]);
                var marker = L.marker([lat, lng]).addTo(map);
                map.setView([lat, lng], 12);
            }
        }
    </script>
}
